# Copy to web/.env.local and fill in real values. Never commit web/.env.local.
# Every value here ends up in the shipped browser bundle -- only public,
# client-safe values belong in this file.

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# The anon key is a public, publishable key, safe for the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the ShopSense API (api/), no trailing slash.
VITE_API_BASE_URL=http://localhost:3000/api
