# Copy to api/.env and fill in real values. Never commit api/.env.

PORT=3000

# Supabase project settings (Project Settings > API in the Supabase dashboard).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Postgres connection string (Project Settings > Database).
# Use the transaction pooler connection string (port 6543), not the direct
# connection (port 5432) — see B3: the app needs real transactions and the
# direct connection's connection limit is too low for a pooled Node backend.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Claude API (console.anthropic.com).
ANTHROPIC_API_KEY=

# Comma-separated list of browser origins allowed to call this API (CORS).
# Defaults to the Vite dev server if unset.
CORS_ORIGIN=http://localhost:5173
